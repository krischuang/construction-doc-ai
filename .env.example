# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/construction_doc_ai?schema=public"

# Optional. When unset, extraction uses the deterministic mock transport
# (see lib/claude-transport.ts) and the app, tests, and evaluation suite
# all work with zero external dependencies. Set this to call the real
# Claude API instead.
ANTHROPIC_API_KEY=

# Where validated records are POSTed after extraction. Defaults to the
# bundled mock receiver at /api/mock-erp-webhook, so the full flow is
# demonstrable with no external service configured. Point this at a real
# ERP's ingest endpoint for an actual integration.
ERP_WEBHOOK_URL="http://localhost:3000/api/mock-erp-webhook"
